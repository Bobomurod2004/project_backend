# ── Django ──
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Frontendlar domeni (CORS)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://ai.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://ai.example.com

# Gunicorn
GUNICORN_WORKERS=3

# ── PostgreSQL ──
# (bo'sh qoldirilsa SQLite ishlatiladi)
POSTGRES_DB=hisobot
POSTGRES_USER=hisobot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Production xavfsizlik (HTTPS bo'lsa) ──
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
