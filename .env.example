# ── Django ──
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Frontendlar domeni (CORS)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://ai.example.com

# CSRF ishonchli manzillar (admin/forma POST uchun SHART).
# Sayt qaysi manzil orqali ochilsa — shuni yozing (sxema bilan!).
# HTTP/IP misol:  http://178.128.100.231
# HTTPS misol:    https://app.example.com
CSRF_TRUSTED_ORIGINS=http://178.128.100.231

# Gunicorn
GUNICORN_WORKERS=3

# ── PostgreSQL ──
# (bo'sh qoldirilsa SQLite ishlatiladi)
POSTGRES_DB=hisobot
POSTGRES_USER=hisobot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Cookie xavfsizligi ──
# HTTPS bo'lsa: True (tavsiya).
# HTTP (IP/SSL yo'q) bo'lsa: MAJBURAN False — aks holda admin/login
# CSRF cookie o'rnatilmaydi va 403 CSRF xatosi chiqadi.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
