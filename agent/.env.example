# ── Django API ulanish ──
# Docker'da: http://web:8000/api (compose avtomatik beradi)
# Lokal: http://localhost:8001/api
DJANGO_API=http://localhost:8001/api

# ── Ollama LLM ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-coder-next:cloud
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_TIMEOUT=300
LLM_MAX_TOKENS=1800
OLLAMA_NUM_PREDICT=1800

# ── CORS (front_ai domeni) ──
# Production: https://ai.example.com
CORS_ORIGINS=*
